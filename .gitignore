# ====================================================================
# Git Ignore Configuration for Victoria 2 Mobile (Project Alice)
# ====================================================================

# Upstream cloned repositories (managed separately)
/upstream/

# Game Data Directory (PC Victoria 2 assets, keep README.md)
/game_data/*
!/game_data/README.md

# Build Directories (Root and nested variants)
build*/
cmake-build-*/
out/
bin/
/scratch/
/assets/

# Android & Gradle Build Artifacts
.gradle/
android/.gradle/
android/.cxx/
android/build/
android/app/build/
android/app/.cxx/
local.properties
android/local.properties
*.apk
*.aab
*.keystore
*.jks
*.ap_
*.hprof

# Native Binaries & Shared Libraries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# C/C++ Intermediate Compilation Artifacts
*.o
*.obj
*.pch
*.gch
*.pdb
*.ilk
*.dmp
*.ninja_deps
*.ninja_log
.ninja_*
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
compile_commands.json

# Game Caches, Scenarios & Save Data
*.bin
*.sav
*.log
vic2_log.txt
vic2_crash_log.txt

# Scripting & Windows Prebuilts
src/engine/scripting/llvm-c/LLVM-C.dll
src/engine/scripting/llvm-c/LLVM-C.lib

# IDE & Editor Artifacts
.idea/
.vscode/
*.iml
*.suo
*.user
*.vcxproj.user
.vs/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
*.bundle
